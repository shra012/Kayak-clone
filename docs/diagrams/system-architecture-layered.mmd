graph TB
    subgraph Layer1["🌐 PRESENTATION LAYER"]
        UI[React 18 Frontend<br/>Vite + Redux + React Query<br/>Port: 5173]
    end
    
    subgraph Layer2["🚪 API GATEWAY LAYER"]
        Gateway[Express.js API Gateway<br/>Middleware Stack<br/>Port: 3000]
    end
    
    subgraph Layer3["⚙️ BUSINESS LOGIC LAYER"]
        direction LR
        Services[7 Microservices<br/>━━━━━━━━━━━━━━━━━━━━<br/>User | Listings | Bookings<br/>Payments | Admin<br/>Concierge | Analytics]
    end
    
    subgraph Layer4["💾 DATA PERSISTENCE LAYER"]
        direction LR
        PG[(PostgreSQL<br/>Supabase<br/>Relational Data)]
        MONGO[(MongoDB<br/>Atlas<br/>Document Store)]
        REDIS[(Redis<br/>Cloud<br/>Cache)]
    end
    
    subgraph Layer5["📨 EVENT STREAMING"]
        KAFKA[Kafka Event Bus<br/>Aiven Cloud<br/>Async Communication]
    end
    
    subgraph Layer6["🔗 EXTERNAL SERVICES"]
        direction LR
        FB[Firebase Storage<br/>Images]
        AI[AI Agent Service<br/>FastAPI :8000]
    end
    
    UI -->|HTTP/REST| Gateway
    Gateway --> Services
    Services --> PG
    Services --> MONGO
    Services --> REDIS
    Services -->|Publish| KAFKA
    KAFKA -->|Consume| Services
    Gateway --> FB
    Services --> AI
    
    style UI fill:#2196F3,color:#fff,stroke:#1976D2,stroke-width:3px
    style Gateway fill:#FF9800,color:#fff,stroke:#F57C00,stroke-width:3px

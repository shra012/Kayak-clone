flowchart TB
    subgraph "🌐 PRESENTATION LAYER"
        direction TB
        Frontend["React 18 Single Page Application<br/>━━━━━━━━━━━━━━━━━━━━<br/>• Vite Build Tool<br/>• Redux Toolkit (State)<br/>• React Query (Server State)<br/>• Tailwind CSS + DaisyUI<br/>• React Router (Routing)"]
    end
    
    subgraph "🚪 API GATEWAY LAYER"
        direction TB
        Gateway["Express.js Monolithic Gateway<br/>━━━━━━━━━━━━━━━━━━━━<br/>Port: 3000 | REST API: /api/v1/*"]
        
        subgraph MW["Middleware Pipeline"]
            M1["🔐 Helmet (Security)"]
            M2["🌐 CORS"]
            M3["📦 Compression"]
            M4["⏱️ Rate Limiting"]
            M5["🔑 JWT Auth"]
            M6["✅ Validation"]
            M7["📝 Logging (Winston)"]
        end
        
        Gateway --> M1 --> M2 --> M3 --> M4 --> M5 --> M6 --> M7
    end
    
    subgraph "⚙️ BUSINESS LOGIC LAYER"
        direction LR
        
        subgraph Core["Core Business Services"]
            direction TB
            US["👤 User Service<br/>━━━━━━━━━━<br/>• Authentication<br/>• Profile Management<br/>• RBAC"]
            LS["🔍 Listings Service<br/>━━━━━━━━━━<br/>• Search Flights/Hotels/Cars<br/>• Filtering & Pagination<br/>• Availability Check"]
            BS["📅 Bookings Service<br/>━━━━━━━━━━<br/>• Create Bookings<br/>• Status Management<br/>• Conflict Detection"]
            PS["💳 Payments Service<br/>━━━━━━━━━━<br/>• Payment Processing<br/>• Refunds<br/>• Idempotency"]
        end
        
        subgraph Support["Support Services"]
            direction TB
            AS["⚙️ Admin Service<br/>━━━━━━━━━━<br/>• Inventory Management<br/>• User Management<br/>• Reports"]
            CS["🤖 Concierge Service<br/>━━━━━━━━━━<br/>• AI Recommendations<br/>• Bundles<br/>• Price Watches"]
            AN["📊 Analytics Service<br/>━━━━━━━━━━<br/>• User Tracking<br/>• Click Analytics<br/>• Cohort Analysis"]
        end
    end
    
    subgraph "💾 DATA PERSISTENCE LAYER"
        direction TB
        
        subgraph RDBMS["Relational Database"]
            PG["🗄️ PostgreSQL (Supabase)<br/>━━━━━━━━━━━━━━━━━━━━<br/>📋 Tables:<br/>  • users<br/>  • bookings<br/>  • payments<br/>  • reviews<br/><br/>🔗 ACID Transactions<br/>🔑 Foreign Keys<br/>📊 Complex Joins"]
        end
        
        subgraph NoSQL["Document Database"]
            MONGO["📄 MongoDB Atlas<br/>━━━━━━━━━━━━━━━━━━━━<br/>📦 Collections:<br/>  • flights<br/>  • hotels<br/>  • cars<br/>  • concierge_sessions<br/>  • user_traces<br/><br/>🔀 Flexible Schema<br/>📈 High Read Volume<br/>🔍 Search Optimized"]
        end
        
        subgraph Cache["Cache Layer"]
            REDIS["⚡ Redis Cloud<br/>━━━━━━━━━━━━━━━━━━━━<br/>💾 Cache Keys:<br/>  • listing:{type}:{id}<br/>  • user:{userId}<br/>  • search:{type}:{hash}<br/><br/>⏱️ TTL: 60-600s<br/>🚦 Rate Limiting<br/>💼 Session Storage"]
        end
    end
    
    subgraph "📨 EVENT STREAMING LAYER"
        KAFKA["Kafka Event Bus (Aiven Cloud)<br/>━━━━━━━━━━━━━━━━━━━━<br/>📬 Topics:<br/>  • bookings.created<br/>  • bookings.updated<br/>  • payments.created<br/>  • payments.succeeded<br/>  • payments.refunded<br/>  • inventory.updated<br/><br/>🔄 Async Communication<br/>📡 Event-Driven Architecture"]
    end
    
    subgraph "🔗 EXTERNAL INTEGRATIONS"
        direction LR
        FB["☁️ Firebase Storage<br/>━━━━━━━━━━<br/>• Image Hosting<br/>• File Storage<br/>• CDN Delivery"]
        AI["🧠 AI Agent Service<br/>━━━━━━━━━━<br/>• FastAPI :8000<br/>• LLM Integration<br/>• Intent Parsing<br/>• Bundle Generation"]
    end
    
    %% Connections
    Frontend -->|"HTTPS/REST<br/>JSON"| Gateway
    Gateway --> US
    Gateway --> LS
    Gateway --> BS
    Gateway --> PS
    Gateway --> AS
    Gateway --> CS
    Gateway --> AN
    
    US -->|"ACID<br/>Transactions"| PG
    BS -->|"ACID<br/>Transactions"| PG
    PS -->|"ACID<br/>Transactions"| PG
    AS -->|"ACID<br/>Transactions"| PG
    
    LS -->|"Document<br/>Queries"| MONGO
    CS -->|"Document<br/>Queries"| MONGO
    AN -->|"Document<br/>Queries"| MONGO
    
    LS -->|"Cache<br/>Read/Write"| REDIS
    US -->|"Cache<br/>Read/Write"| REDIS
    
    BS -->|"Publish<br/>Events"| KAFKA
    PS -->|"Publish<br/>Events"| KAFKA
    AS -->|"Publish<br/>Events"| KAFKA
    
    KAFKA -->|"Consume<br/>Events"| AN
    KAFKA -->|"Consume<br/>Events"| CS
    
    Gateway -->|"Upload<br/>Images"| FB
    CS -->|"API<br/>Calls"| AI
    

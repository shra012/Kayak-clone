graph TB
    subgraph "CLIENT TIER"
        direction TB
        WebApp["🌐 Web Application<br/>React 18 + Vite<br/>Port: 5173"]
        WebApp -->|"User Interactions"| UserActions["Search | Book | Pay | Manage"]
    end
    
    subgraph "API GATEWAY TIER"
        direction TB
        Gateway["🚪 Express.js API Gateway<br/>Port: 3000<br/>REST API /api/v1/*"]
        
        subgraph "Middleware Stack"
            AuthMW["🔐 Authentication<br/>JWT Validation"]
            RateLimit["⏱️ Rate Limiting<br/>500 req/15min"]
            Validation["✅ Request Validation"]
            ErrorHandler["⚠️ Error Handling"]
        end
        
        Gateway --> AuthMW
        Gateway --> RateLimit
        Gateway --> Validation
        Gateway --> ErrorHandler
    end
    
    subgraph "SERVICE TIER"
        direction LR
        
        subgraph "Core Services"
            UserSvc["👤 User Service<br/>Authentication<br/>Profile Management"]
            ListingSvc["🔍 Listings Service<br/>Flights | Hotels | Cars<br/>Search & Filter"]
            BookingSvc["📅 Bookings Service<br/>Booking Creation<br/>Status Management"]
            PaymentSvc["💳 Payments Service<br/>Payment Processing<br/>Refunds"]
        end
        
        subgraph "Support Services"
            AdminSvc["⚙️ Admin Service<br/>Inventory Management<br/>User Management"]
            ConciergeSvc["🤖 Concierge Service<br/>AI Recommendations<br/>Bundles"]
            AnalyticsSvc["📊 Analytics Service<br/>User Tracking<br/>Reports"]
        end
    end
    
    subgraph "DATA TIER"
        direction TB
        
        subgraph "Relational Database"
            PostgreSQL["🗄️ PostgreSQL<br/>(Supabase Cloud)<br/><br/>• Users<br/>• Bookings<br/>• Payments<br/>• Reviews"]
        end
        
        subgraph "Document Database"
            MongoDB["📄 MongoDB Atlas<br/><br/>• Flights<br/>• Hotels<br/>• Cars<br/>• Concierge Sessions<br/>• User Traces"]
        end
        
        subgraph "Cache Layer"
            Redis["⚡ Redis Cloud<br/><br/>• Listing Cache<br/>• User Cache<br/>• Search Cache<br/>• Rate Limiting"]
        end
    end
    
    subgraph "MESSAGE QUEUE"
        Kafka["📨 Kafka Event Bus<br/>(Aiven Cloud)<br/><br/>Topics:<br/>• bookings.*<br/>• payments.*<br/>• inventory.*"]
    end
    
    subgraph "EXTERNAL SERVICES"
        direction LR
        Firebase["☁️ Firebase Storage<br/>Image Hosting"]
        AIAgent["🧠 AI Agent Service<br/>FastAPI :8000<br/>LLM Integration"]
    end
    
    %% Client to Gateway
    WebApp -->|"HTTP/REST"| Gateway
    
    %% Gateway to Services
    Gateway --> UserSvc
    Gateway --> ListingSvc
    Gateway --> BookingSvc
    Gateway --> PaymentSvc
    Gateway --> AdminSvc
    Gateway --> ConciergeSvc
    Gateway --> AnalyticsSvc
    
    %% Services to Databases
    UserSvc --> PostgreSQL
    BookingSvc --> PostgreSQL
    PaymentSvc --> PostgreSQL
    AdminSvc --> PostgreSQL
    
    ListingSvc --> MongoDB
    ConciergeSvc --> MongoDB
    AnalyticsSvc --> MongoDB
    
    ListingSvc --> Redis
    UserSvc --> Redis
    
    %% Services to Kafka
    BookingSvc -->|"Publish Events"| Kafka
    PaymentSvc -->|"Publish Events"| Kafka
    AdminSvc -->|"Publish Events"| Kafka
    
    %% Kafka to Consumers
    Kafka -->|"Consume Events"| AnalyticsSvc
    Kafka -->|"Consume Events"| ConciergeSvc
    
    %% External Services
    Gateway --> Firebase
    ConciergeSvc --> AIAgent
    
    %% Styling
    style WebApp fill:#2196F3,color:#fff,stroke:#1976D2,stroke-width:3px
    style Gateway fill:#FF9800,color:#fff,stroke:#F57C00,stroke-width:3px
    style UserSvc fill:#4CAF50,color:#fff
    style ListingSvc fill:#4CAF50,color:#fff
    style BookingSvc fill:#4CAF50,color:#fff
    style PaymentSvc fill:#4CAF50,color:#fff
    style AdminSvc fill:#9C27B0,color:#fff
    style ConciergeSvc fill:#9C27B0,color:#fff
    style AnalyticsSvc fill:#9C27B0,color:#fff
    style PostgreSQL fill:#336791,color:#fff,stroke:#2C5F7A,stroke-width:2px
    style MongoDB fill:#47A248,color:#fff,stroke:#3D8B40,stroke-width:2px
    style Redis fill:#DC382D,color:#fff,stroke:#C62828,stroke-width:2px
    style Kafka fill:#231F20,color:#fff,stroke:#000,stroke-width:2px
    style Firebase fill:#FFA000,color:#fff,stroke:#F57C00,stroke-width:2px

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ssn             String?   @unique
  firstName       String    @map("first_name") @db.VarChar(80)
  lastName        String    @map("last_name") @db.VarChar(80)
  email           String    @unique
  passwordHash    String?   @map("password_hash") @db.VarChar(255)
  phoneNumber     String    @map("phone_number") @db.VarChar(15)
  addressLine1    String    @map("address_line1")
  addressLine2    String?   @map("address_line2")
  addressCity     String    @map("address_city")
  addressState    String    @map("address_state") @db.Char(2)
  addressZipCode  String    @map("address_zip_code") @db.VarChar(10)
  profileImageUrl String?   @map("profile_image_url")
  role            String    @default("user")
  loyaltyTier     String    @default("none") @map("loyalty_tier")
  profileType     String    @default("traveler") @map("profile_type")
  ssnVerifiedAt   DateTime? @map("ssn_verified_at")
  partnerDetails  Json?     @map("partner_details")
  lastLogin       DateTime? @map("last_login")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  bookings Booking[]
  payments Payment[]
  reviews  Review[]

  @@index([email])
  @@index([addressState])
  @@map("users")
}

model Booking {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user          User     @relation(fields: [userId], references: [id])
  userId        String   @map("user_id") @db.Uuid
  bookingType   String   @map("booking_type") @db.VarChar(20)
  status        String   @default("PENDING")
  priceAmount   Decimal? @map("price_amount")
  priceCurrency String   @default("USD") @map("price_currency") @db.Char(3)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  payments Payment[]

  @@index([userId])
  @@index([status])
  @@map("bookings")
}

model Payment {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  booking              Booking  @relation(fields: [bookingId], references: [id])
  bookingId            String   @map("booking_id") @db.Uuid
  user                 User     @relation(fields: [userId], references: [id])
  userId               String   @map("user_id") @db.Uuid
  status               String   @default("PENDING")
  amount               Decimal  @db.Decimal(10, 2)
  currency             String   @default("USD") @db.Char(3)
  transactionReference String?  @map("transaction_reference")
  invoiceUrl           String?  @map("invoice_url")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@index([bookingId])
  @@index([userId])
  @@map("payments")
}

model Review {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user        User     @relation(fields: [userId], references: [id])
  userId      String   @map("user_id") @db.Uuid
  listingType String   @map("listing_type") @db.VarChar(20)
  listingId   String   @map("listing_id") @db.VarChar(100)
  rating      Int      @db.SmallInt
  title       String?  @db.VarChar(120)
  body        String?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("reviews")
}
